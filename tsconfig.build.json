// The declarations: dist/**/*.d.ts with their doc comments, which
// api-extractor (docs/api) and consumers' editors read. The JavaScript is
// emitted by tsconfig.build.js.json, without comments; `pnpm build` runs
// both.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "types": []
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.testing.ts",
    "src/map/test/**",
    "src/api/test/**",
    "src/live/test/**"
  ]
}
